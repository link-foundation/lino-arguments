{
  "name": "lino-arguments",
  "version": "0.3.0",
  "description": "A setup of Links Notation Environment (lenv) + yargs to support easy configuration of CLI apps",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node ../scripts/check-file-size.mjs",
    "check:dependencies": "npm outdated",
    "check": "npm run lint && npm run format:check && npm run check:file-size",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node ../scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:validate": "node ../scripts/validate-changeset.mjs",
    "changeset:create": "node ../scripts/create-manual-changeset.mjs"
  },
  "keywords": [
    "lino",
    "arguments",
    "cli",
    "yargs",
    "environment",
    "links-notation",
    "config"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/lino-arguments.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "dependencies": {
    "getenv": "^2.0.0",
    "links-notation": "^0.23.0",
    "lino-env": "^0.2.8",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "@dotenvx/dotenvx": "^2.33.0"
  },
  "peerDependenciesMeta": {
    "@dotenvx/dotenvx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dotenvx/dotenvx": "^2.33.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "test-anywhere": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
